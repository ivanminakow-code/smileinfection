UserInputService.InputChanged:Connect(function(input)
    if buttonDragActive then
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - buttonDragStartPos
            local newX = buttonStartPosition.X.Scale
            local newXOffset = buttonStartPosition.X.Offset + delta.X
            local newY = buttonStartPosition.Y.Scale
            local newYOffset = buttonStartPosition.Y.Offset + delta.Y
            
            local screenSize = gui.AbsoluteSize
            local btnSize = floatingButton.AbsoluteSize
            
            local maxX = screenSize.X - btnSize.X
            local maxY = screenSize.Y - btnSize.Y
            
            local finalXScale = newX + (newXOffset / screenSize.X)
            local finalYScale = newY + (newYOffset / screenSize.Y)
            
            floatingButton.Position = UDim2.new(math.clamp(finalXScale, 0, maxX/screenSize.X), 0, math.clamp(finalYScale, 0, maxY/screenSize.Y), 0)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
