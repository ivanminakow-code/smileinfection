    espEnabled = not espEnabled
    espBtn.Text = espEnabled and "🎨 ESP: ВКЛ" or "🎨 ESP: ВЫКЛ"
    espBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(80, 200, 120) or Color3.fromRGB(45, 45, 58)
    if espEnabled then
