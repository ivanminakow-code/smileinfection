local function updateFlySpeed(inputPos)
    local trackPos = flySliderTrack.AbsolutePosition.X
    local trackWidth = flySliderTrack.AbsoluteSize.X
    if trackWidth <= 0 then return end
    local percent = math.clamp((inputPos - trackPos) / trackWidth, 0, 1)
    flySpeed = math.floor(20 + percent * 80)
    flySpeedLabel.Text = "СКОРОСТЬ ПОЛЕТА: " .. flySpeed
    flySliderFill.Size = UDim2.new(percent, 0, 1, 0)
    flySliderKnob.Position = UDim2.new(percent, -knobSize/2, 0.5, -knobSize/2)
end

local function updateWalkSpeed(inputPos)
    local trackPos = walkSliderTrack.AbsolutePosition.X
    local trackWidth = walkSliderTrack.AbsoluteSize.X
    if trackWidth <= 0 then return end
    local percent = math.clamp((inputPos - trackPos) / trackWidth, 0, 1)
