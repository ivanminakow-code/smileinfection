-- ФИГ на весь экран в Roblox + XENO
-- Работает на Windows-версии Roblox с инжектором XENO (уровень 8)

local player = game:GetService("Players").LocalPlayer
local mouse = player:GetMouse()
local runService = game:GetService("RunService")

-- === ВАРИАНТ 1: ЧИСТЫЙ ROBLOX GUI (НЕ ЗАВИСИТ ОТ DRAWING API) ===
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FIG_GUI_FULLSCREEN"
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
screenGui.IgnoreGuiInset = true           -- Игнорирует панель чата/здоровья
screenGui.ScreenInsets = Enum.ScreenInsets.None  -- Полный вывод на весь экран

local textLabel = Instance.new("TextLabel")
textLabel.Name = "FIG_LABEL"
textLabel.Text = "ФИГ"
textLabel.TextScaled = true               -- Автомасштабирование шрифта
textLabel.TextSize = 1000                 -- Запас на случай отключения TextScaled
textLabel.TextColor3 = Color3.fromRGB(255, 0, 0)  -- Ярко-красный
textLabel.BackgroundTransparency = 1      -- Прозрачный фон
textLabel.Size = UDim2.new(1, 0, 1, 0)    -- 100% ширины, 100% высоты
textLabel.Position = UDim2.new(0, 0, 0, 0)
textLabel.BorderSizePixel = 0

-- Подтверждение поверх всего (включая внутриигровые интерфейсы)
textLabel.ZIndex = 9999

textLabel.Parent = screenGui
screenGui.Parent = player:WaitForChild("PlayerGui")

-- === ДОПОЛНИТЕЛЬНО: АНИМАЦИЯ ПУЛЬСАЦИИ (НЕ ОБЯЗАТЕЛЬНО, НО ДЛЯ ЗАМЕТНОСТИ) ===
local t = 0
runService.RenderStepped:Connect(function(dt)
    t = t + dt * 3
    local scale = 1 + math.sin(t) * 0.15
    textLabel.TextScaled = true
    -- Через TextScaled нельзя напрямую scale, но можно менять TextSize при выкл. TextScaled
    -- Для простоты — просто мерцание цвета:
    local r = 128 + math.sin(t * 5) * 127
    textLabel.TextColor3 = Color3.fromRGB(r, 0, 0)
end)

-- === ВАРИАНТ 2: DRAWING API (ЕСЛИ XENO ПОДДЕРЖИВАЕТ) ===
-- Этот вариант перекрывает даже системные UI Roblox (меню ESC и т.д.)
-- Работает через окно поверх Roblox через Overlay/XenoDrawing

if Drawing and Drawing.new then
    local textDraw = Drawing.new("Text")
    textDraw.Text = "ФИГ"
    textDraw.Size = 100
    textDraw.Position = Vector2.new(0, 0)
    textDraw.Color = Color3.fromRGB(255, 0, 0)
    textDraw.Outline = true
    textDraw.OutlineColor = Color3.fromRGB(0, 0, 0)
    textDraw.Center = true
    
    -- Динамический размер под экран
    local function updateFullscreen()
        local viewport = game:GetService("Workspace").CurrentCamera.ViewportSize
        textDraw.Size = math.min(viewport.X, viewport.Y) * 0.3  -- 30% от меньшей стороны
        textDraw.Position = Vector2.new(viewport.X / 2, viewport.Y / 2)
    end
    
    updateFullscreen()
    game:GetService("Workspace").CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateFullscreen)
    
    -- Бесконечный рендер
    runService.RenderStepped:Connect(updateFullscreen)
    
    -- Очистка при выгрузке скрипта
    local function cleanup()
        if textDraw and textDraw.Remove then
            textDraw:Remove()
        end
    end
    game:GetService("Players").LocalPlayer.OnTeleport:Connect(cleanup)
    game:GetService("CoreGui").ChildRemoved:Connect(cleanup)
else
    print("Drawing API не найден, используем обычный ScreenGui")
end

