local function findKillbricks()
    local bricks = {}
    local map = workspace:FindFirstChild("Map")
    local searchSpace = map or workspace
    for _, part in pairs(searchSpace:GetDescendants()) do
        if part:IsA("BasePart") and part:FindFirstChild("TouchInterest") then
            local nameLower = string.lower(part.Name or "")
            if string.find(nameLower, "kill") then
                table.insert(bricks, part)
            end
        end
    end
    return bricks
end

